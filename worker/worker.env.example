# Names only. Values go in /etc/revenue-worker.env on the worker (mode 600), by Justin, never in chat or the pack.
WORKER_HOME=/opt/revenue-worker
WORKER_TOKEN=
# Alarms and waking the bot
SLACK_ALARM_WEBHOOK_URL=
BOT_REPLY_WEBHOOK_URL=
# The engine's keys the volume jobs use (same names as the bot's .env.example)
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=
CONSULTI_API_KEY=
RADAR_APP_URL=
RADAR_DASHBOARD_PASSWORD=
SPEAKERAGENT_API_URL=
SPEAKERAGENT_API_KEY=
SPEAKERAGENT_SPEAKER_ID=
DECODO_PROXY_USER=
DECODO_PROXY_PASSWORD=
SCRAPEBOX_URL=
SCRAPEBOX_TOKEN=
REACHER_URL=
# The brains, cheapest first (THINK_TIERS order). codex needs no key here: Justin signs the Codex CLI in once.
THINK_TIERS=codex,hermes,api
HERMES_PROFILE=
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_USD_PER_MTOK=
