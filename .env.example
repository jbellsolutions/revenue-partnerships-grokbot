# Names only. Real values go in /workspace/revenue-partnerships/.secrets/<system>.env (mode 600) by hidden prompt or a secure secret card.
# Role in brackets. Never commit a value. Any key ever pasted in a chat is rotated first.
GTM_HOME=/workspace/revenue-partnerships/gtm-box
# [lead] Slack and Notion
SLACK_BOT_TOKEN=
NOTION_TOKEN=
# [sales-crm, lead] GoHighLevel (read-only key first). GHL_LOCATION_ID is the one location crm.py trusts; unset, it refuses every call
GHL_API_KEY=
GHL_LOCATION_ID=
# [sales-crm] the guarded sender and Cal.com
SENDER_URL=
SENDER_TOKEN=
CAL_API_KEY=
# [cold-email, social, partners] lead data
CONSULTI_API_KEY=
TREG_API_KEY=
# [cold-email] sending tools
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=
MAILDOSO_API_KEY=
INSTANTLY_API_KEY=
AGENTMAIL_API_KEY=
LEAD_CREDIT_CAP=
# [cold-email] scrapers: One API, Scrapebox, Decodo (prepaid; paid use runs under the $5 a day scrape pool)
ONE_API_URL=
ONE_API_TOKEN=
SCRAPEBOX_TOKEN=
SCRAPEBOX_URL=
DECODO_PROXY_USER=
DECODO_PROXY_PASSWORD=
# [social] Lead Radar and the LinkedIn dashboard
RADAR_APP_URL=
RADAR_DASHBOARD_PASSWORD=
LINKEDIN_DASH_TOKEN=
# [speaker]
SPEAKERAGENT_API_URL=
SPEAKERAGENT_API_KEY=
SPEAKERAGENT_SPEAKER_ID=
# [content-seo] RankSpot (truerevenuepartnerships.com workspace) and beehiiv
RANKSPOT_API_KEY=
BEEHIIV_API_KEY=
# [content-seo] only if Justin already holds an old Medium integration token (Medium issues no new ones)
MEDIUM_INTEGRATION_TOKEN=
# --- Non-secret intake values (Justin pastes these at intake; NEEDS-JUSTIN item 15). Kept out of the public pack. ---
# [sales-crm] GoHighLevel agency (company) id, for the gohighlevel-cli skill
GHL_COMPANY_ID=
# [sales-crm] the chief-sales-officer ledger's install folder and database
CSO_HOME=
CSO_DB=
# [speaker] the SpeakerAgent research runner (default ~/speakeragent/runtime/daily.py)
SPEAKER_RUNNER=
# [content-seo] the SEO campaign's id in gtm-box/seo/config/campaign.json
SEO_CAMPAIGN_ID=
# [sales-crm] the approved booking link {{booking_link}} fills; unset, every template that needs it is refused
BOOKING_LINK=
# [speaker] Justin's own calendar link, given only when a host asks for it; never in a pitch (speaker/SPEAKERAGENT.md)
SPEAKER_BOOKING_LINK=
# [cold-email] the held Instantly campaign whose senders and people stay out (its id, or none) and its name; unset, the mailbox plan and push refuse
INSTANTLY_HELD_CAMPAIGN=
HELD_CAMPAIGN_NAME=
# [cold-email] the Instantly tag on the pre-warmed winnr mailboxes
INSTANTLY_WINNR_TAG_ID=
# [cold-email] the cold sending site a cold email may link (cold-copy check.py)
COLD_SITE_URL=
# [cold-email] Reacher email verification: backend URL, the humans' dashboard, and the agent's consumer key (secret, hidden prompt)
REACHER_URL=
REACHER_DASHBOARD_URL=
REACHER_CONSUMER_KEY=
# [cold-email] the One API hub page (skill page and guides)
ONE_API_HUB_URL=
# [social] the LinkedIn engagement dashboard's base URL
LINKEDIN_DASH_URL=
# [lead] the Slack channel id where agent-team artifacts are shared
SLACK_ARTIFACT_CHANNEL_ID=
# [content-seo] the content repo's git URL (through a deploy key) and its SSH config Host alias (content_pull.py)
CONTENT_REPO_REMOTE=
CONTENT_REPO_SSH_HOST=
# [setup] where the pack's release zip is downloaded
PACK_RELEASE_URL=
# [cold-email] folder holding the licensed copywriting course material (else .secrets/course/)
COURSE_MATERIAL_DIR=
# [all] guard lists, comma-separated (or .secrets/never-touch.txt and .secrets/do-not-mention.txt, one per line).
# NEVER_TOUCH: computers, agents and organizations no role may write to; missing = never_touch.py refuses every guarded write.
# DO_NOT_MENTION: people, groups and products outreach never names; missing = cold-copy check.py fails every campaign.
NEVER_TOUCH=
DO_NOT_MENTION=
# [all] the worker (WORKERS.md): its HTTPS address and token. The guards use it for suppression, spend, STOP and approvals
WORKER_URL=
WORKER_TOKEN=
