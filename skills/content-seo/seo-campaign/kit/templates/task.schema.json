{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable campaign task",
  "type": "object",
  "required": [
    "id",
    "epic",
    "title",
    "outcome",
    "owner_role",
    "status",
    "depends_on",
    "authority_ref",
    "outputs",
    "acceptance",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "epic": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "status": {
      "enum": [
        "INBOX",
        "READY",
        "RUNNING",
        "VERIFYING",
        "DONE",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authority_ref": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
